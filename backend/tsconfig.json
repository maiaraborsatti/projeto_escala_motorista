{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}